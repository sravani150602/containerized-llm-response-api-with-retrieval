# Copy to .env and adjust. Every value is optional.
LLM_BACKEND=hf
BASE_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
ADAPTER_PATH=artifacts/lora-adapter
MERGE_ADAPTER=true
MAX_NEW_TOKENS=96
TOP_K=4

# Storage: "local" reads ./knowledge_base, "s3" reads the bucket below
STORAGE_BACKEND=local
S3_BUCKET=llm-rag-knowledge-base
S3_PREFIX=kb/
# S3_ENDPOINT_URL=http://localhost:9000   # MinIO; leave unset for real AWS S3
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
